# Cache rules for static assets (Workers Static Assets reads this file).
# Dynamic routes set their own headers in the Worker.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Fonts never change under the same name: cache for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Icons rarely change; a month, then revalidate in the background.
/icons/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon-*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The pre-rendered OG cards (scripts/og-render.ts). /og.png serves them with its own caching.
/og/*
  Cache-Control: public, max-age=86400

# App code: short, so a deploy (plus the admin "reload every browser" button) lands quickly.
/app.js
  Cache-Control: public, max-age=300, stale-while-revalidate=60

/styles.css
  Cache-Control: public, max-age=300, stale-while-revalidate=60

# The service worker must always be fresh, or updates get stuck behind the old one.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
